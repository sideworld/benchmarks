# per-fork Compose overrides are generated by mkfork.sh; fork1 is committed as the example
/docker-compose.fork*.yml
!/docker-compose.fork1.yml
# The repo-wide `bin/` rule above is meant for built Go binaries; vm/guest mirrors
# a filesystem, so its /usr/local/bin is source, not output.
!/vm/guest/usr/local/bin/

# Firecracker build artefacts: kernel sources, debootstrap/apt caches, and the
# multi-GB kernel + rootfs + image archive the vm/ scripts produce.
/vm/cache/
/vm/out/

# off-box backup target (user@host of the Storage Box); see ops/backup.md
ops/backup.env
