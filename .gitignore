*.log
.DS_Store
__pycache__/
*.pyc
node_modules/
# generated fork maps / per-fork Compose overrides (mkfork-generic writes them next to the adapters)
benchmarks/*/fork.map
benchmarks/*/compose/docker-compose.*-f*.yml
# per-run secrets minted by the adapters (Mastodon OAuth tokens etc.)
benchmarks/*/.token*
# TrainTicket's fork.map is committed (hand-written); keep it
!benchmarks/trainticket/fork.map
