# Guest only: every service on every interface, on the ports the fork forwards
# (GUEST_PORTS, in order: 8080 -> 3<kk>80, 8081 -> 90, 8082 -> 70, 8083 -> 60). Otherwise
# identical to cascade.env, so a fork runs what the baseline was measured under.
CASCADE_BIND=0.0.0.0
API_PORT=8080
BILLING_PORT=8081
DASHBOARD_PORT=8082
INGEST_PORT=8083
