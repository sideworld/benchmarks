# Guest only: every port on every interface. The fork forwards GUEST_PORTS, the gateway's 8080
# alone, to 3<kk>80; the services' own ports are the host's and are not forwarded (PAR-83).
# Otherwise identical to cascade.env, so a fork runs what the baseline was measured under.
CASCADE_BIND=0.0.0.0
GATEWAY_PORT=8080
API_PORT=18480
BILLING_PORT=18481
DASHBOARD_PORT=18482
INGEST_PORT=18483
