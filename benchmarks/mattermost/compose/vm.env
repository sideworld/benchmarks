# Guest-only overrides: inside the microVM the server must answer on every interface, and the
# site URL is whatever the host forwards to. Everything else is identical to mm.env, which is
# the point -- a fork runs the same configuration the baseline was measured under.
MM_SPEC_DIR=/opt/app
MM_SERVER_IMAGE=sideworld/mattermost-server:v11.11.0
MM_BIND=0.0.0.0
MM_SITE_URL=http://localhost:8065
